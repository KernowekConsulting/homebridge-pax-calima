    "extractor",
    "bathroom",
    "supports-hap"
  ],
  "engines": {
    "homebridge": "^1.8.0 || ^2.0.0",
    "node": "^22.12.0 || ^24.0.0"
  },
  "dependencies": {
    "@abandonware/noble": "1.9.2-26"
  },
  "homepage": "https://github.com/KernowekConsulting/homebridge-pax-calima",
  "repository": {
    "type": "git",
